# Arte do player, herdada por todas as salas (assets/rooms/*.room).
# PNGs relativos a assets/sprites. Cada quadro do player mede 32x48.
# Caminhada: 7 quadros em uma linha, com 1 pixel entre quadros.
# Parado: 8 quadros em uma coluna, sem espacamento.
# Uma sala pode sobrescrever um campo com player.<clip>.<campo> (ex.: player.idle.fps = 4).

idle.file = player_idle.png
idle.frame_width = 32
idle.frame_height = 48
idle.frames = 8
idle.columns = 1
idle.fps = 6
idle.display_width = 53.333333

left.file = player_esquerda.png
left.frame_width = 32
