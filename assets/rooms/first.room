# Sala inicial. Edite com o jogo fechado ou use DEBUG e load first.room.
# Coordenadas no mundo 1280x720. Cores = R,G,B,A. Retangulos = X,Y,largura,altura.
[room]
id = first
room.wall_y = 280
room.walkable_y = 300
room.vanishing_x = 640
room.ray_spacing = 160
perspective.far_y = 300
perspective.near_y = 720
perspective.far_scale = 0.55
perspective.near_scale = 1.65
player.start_x = 640
player.start_y = 360
player.width = 48
player.height = 80
player.far_speed = 110
player.near_speed = 330
# PNGs relativos a assets/sprites. Cada quadro do player mede 32x48.
# Caminhada: 7 quadros em uma linha, com 1 pixel entre quadros.
# Parado: 8 quadros em uma coluna, sem espacamento.
player.idle.file = player_idle.png
player.idle.frame_width = 32
player.idle.frame_height = 48
player.idle.frames = 8
player.idle.columns = 1
player.idle.fps = 6
player.idle.display_width = 53.333333
player.left.file = player_esquerda.png
player.left.frame_width = 32
player.left.frame_height = 48
player.left.frames = 7
player.left.columns = 7
player.left.spacing_x = 1
player.left.fps = 8
player.left.display_width = 53.333333
player.right.file = player_direita.png
player.right.frame_width = 32
player.right.frame_height = 48
player.right.frames = 7
player.right.columns = 7
player.right.spacing_x = 1
player.right.fps = 8
player.right.display_width = 53.333333
player.up.file = player_cima.png
player.up.frame_width = 32
player.up.frame_height = 48
player.up.frames = 7
player.up.columns = 7
player.up.spacing_x = 1
player.up.fps = 8
player.up.display_width = 53.333333
player.down.file = player_baixo.png
player.down.frame_width = 32
player.down.frame_height = 48
player.down.frames = 7
player.down.columns = 7
player.down.spacing_x = 1
player.down.fps = 8
player.down.display_width = 53.333333
collision.padding_x = 40
collision.padding_y = 8
wall.color = 171,62,67,255
floor.color = 42,102,175,255
wall.trim_color = 109,39,48,255
floor.guide_color = 68,124,190,255
player.color = 245,194,102,255
player.outline_color = 255,239,205,255
floor.lines = 0.18,0.38,0.62,0.85

[object blue_box]
bounds = 380,345,100,135
