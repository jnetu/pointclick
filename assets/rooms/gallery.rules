# Regras declarativas de gallery.room.

[interact plant]
object_visible plant
flag_not_set inspected_plant
set_flag inspected_plant
give_item gallery_note
say "Havia um bilhete escondido entre as folhas!"

[interact plant]
say "Apenas uma planta bem cuidada no canto da galeria."

# A mesa abre um dialogo com escolhas (gallery.dlg, no "mesa").
[interact table]
start_dialogue mesa

# Playground first <-> gallery: a volta entra por first from_gallery.
[interact door_first]
say "De volta ao primeiro salão."
change_room first from_gallery
