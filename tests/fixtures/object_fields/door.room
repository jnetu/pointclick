# PointClick: coordenadas logicas; cores RGBA; retangulos x,y,w,h
[room]
id = door
player.far_speed = 110
player.near_speed = 330
player.width = 48
player.height = 80
player.start_x = 640
player.start_y = 480
perspective.far_scale = 0.55
perspective.near_scale = 1.65
perspective.far_y = 300
perspective.near_y = 720
